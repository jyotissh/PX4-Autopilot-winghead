!/bin/sh
#
# @name Generic Tiltrotor VTOL
#
# @type VTOL Tiltrotor
# @class VTOL
#
# @board px4_fmu-v2 exclude
# @board bitcraze_crazyflie exclude
#
. ${R}etc/init.d/rc.vtol_defaults
. ${R}etc/init.d/rc.vtol_apps

param set-default CA_AIRFRAME 9
param set-default CA_ROTOR0_TILT 2
param set-default CA_ROTOR2_TILT 1

#Rotors
param set-default CA_ROTOR_COUNT 8

param set-default CA_ROTOR0_PX -1
param set-default CA_ROTOR0_PY 2
param set-default CA_ROTOR0_PZ 1

param set-default CA_ROTOR1_PX -1
param set-default CA_ROTOR1_PY 1
param set-default CA_ROTOR1_PZ 1
param set-default CA_ROTOR1_KM -0.05

param set-default CA_ROTOR2_PX -1
param set-default CA_ROTOR2_PY -1
param set-default CA_ROTOR2_PZ 1

param set-default CA_ROTOR3_PX -1
param set-default CA_ROTOR3_PY -2
param set-default CA_ROTOR3_PZ 1
param set-default CA_ROTOR3_KM -0.05

param set-default CA_ROTOR4_PX 1
param set-default CA_ROTOR4_PY 2
param set-default CA_ROTOR4_PZ -1

param set-default CA_ROTOR5_PX 1
param set-default CA_ROTOR5_PY 1
param set-default CA_ROTOR5_PZ -1
param set-default CA_ROTOR5_KM -0.05

param set-default CA_ROTOR6_PX 1
param set-default CA_ROTOR6_PY -1
param set-default CA_ROTOR6_PZ -1

param set-default CA_ROTOR7_PX 1
param set-default CA_ROTOR7_PY -2
param set-default CA_ROTOR7_PZ -1
param set-default CA_ROTOR7_KM -0.05

#control-allocation
param set-default CA_SV_CS_COUNT 4

param set-default CA_SV_CS0_TYPE 6
param set-default CA_SV_CS0_TRQ_P 0.5
param set-default CA_SV_CS0_TRQ_Y 0.5
param set-default CA_SV_CS1_TYPE 3
param set-default CA_SV_CS1_TRQ_P 0.5
param set-default CA_SV_CS2_TYPE 5
param set-default CA_SV_CS2_TRQ_P 0.5
param set-default CA_SV_CS2_TRQ_Y 0.5
param set-default CA_SV_CS3_TYPE 3
param set-default CA_SV_CS3_TRQ_P 0.5

param set-default CA_SV_CS4_TYPE 6
param set-default CA_SV_CS4_TRQ_P 0.5
param set-default CA_SV_CS4_TRQ_Y 0.5
param set-default CA_SV_CS5_TYPE 3
param set-default CA_SV_CS5_TRQ_P 0.5
param set-default CA_SV_CS6_TYPE 5
param set-default CA_SV_CS6_TRQ_P 0.5
param set-default CA_SV_CS6_TRQ_Y 0.5
param set-default CA_SV_CS7_TYPE 3
param set-default CA_SV_CS7_TRQ_P 0.5

param set-default CA_SV_TL_COUNT 2

#transitions

# param set-default VT_TILT_MC    0
# param set-default VT_TILT_FW    1
# param set-default VT_TILT_TRANS 0.5

param set-default MAV_TYPE 21
param set-default VT_TYPE 1
